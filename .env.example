# Use your PostgreSQL connection string. Example for a local database:
DATABASE_URL=postgresql://postgres:password@localhost:5432/employee_portal

# Use a randomly generated secret with at least 32 characters.
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# Session timeout in seconds (default: 60 seconds; 28800 = 8 hours).
SESSION_TIMEOUT_SECONDS=120

# Used only by `npm run admin:create`.
ADMIN_EMPLOYEE_ID=FA000001
ADMIN_EMPLOYEE_NAME=Portal Administrator
ADMIN_PASSWORD=replace-with-a-strong-password
